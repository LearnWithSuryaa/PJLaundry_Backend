# PJLaundry Backend Environment Variables Template
# JANGAN PERNAH menyimpan kredensial atau service-role secret key asli di file ini atau commit ke Git!

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# SUPABASE_URL: URL Project Supabase Anda (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY: Public/anon key untuk operasi client umum
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# SUPABASE_SERVICE_ROLE_KEY: (Opsional - Server Only) Hanya digunakan jika operasi admin sistem benar-benar membutuhkannya
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Security & CORS
# Pisahkan multiple origin dengan koma, atau gunakan '*' untuk development mobile
CORS_ORIGINS=*

